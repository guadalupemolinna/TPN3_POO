    private Pais buscarPais(String nombre) {
        for (Continente c : continentes)
            for (Pais p : c.getPaises())
                if (p.getNombre().equalsIgnoreCase(nombre)) return p;
        return null;
    }

    private Continente buscarContinente(String nombre) {
        for (Continente c : continentes)
            if (c.getNombre().equalsIgnoreCase(nombre)) return c;
        return null;
    }

    public void listarPaisesDeContinente(String nombreContinente) {
        Continente c = buscarContinente(nombreContinente);
        if (c == null) { System.out.println("  No se encontró: " + nombreContinente); return; }
        System.out.println("\n" + c);
        System.out.println("  " + "─".repeat(90));
        for (Pais p : c.getPaises()) System.out.println(p);
    }

    public void listarProvinciasDeUnPais(String nombrePais) {
        Pais p = buscarPais(nombrePais);
        if (p == null) { System.out.println("  No se encontró: " + nombrePais); return; }
        System.out.println("\n  Provincias de " + p.getNombre() + " (" + p.getCapital() + "):");
        System.out.println("  " + "─".repeat(40));
        for (Provincia pr : p.getProvincias()) System.out.println(pr);
    }

    public void listarLimitrofes(String nombrePais) {
        Pais p = buscarPais(nombrePais);
        if (p == null) { System.out.println("  No se encontró: " + nombrePais); return; }
        System.out.println("\n  Limítrofes de " + p.getNombre() + ":");
        System.out.println("  " + "─".repeat(40));
        if (p.getLimitrofes().isEmpty()) { System.out.println("  Sin limítrofes registrados."); return; }
        for (Pais lim : p.getLimitrofes())
            System.out.println("  → " + lim.getNombre() + " (Capital: " + lim.getCapital() + ")");
    }

    public void listarTodosPaisesPorSuperficie() {
        List<Pais> todos = new ArrayList<>();
        for (Continente c : continentes) todos.addAll(c.getPaises());
        todos.sort(Comparator.comparingDouble(Pais::getSuperficie).reversed());
        System.out.println("\n  Países ordenados por superficie (mayor a menor):");
        System.out.println("  " + "─".repeat(90));
        int i = 1;
        for (Pais p : todos) System.out.printf("  %2d. %s%n", i++, p);
    }

    public void compararPaises(String nombre1, String nombre2) {
        Pais p1 = buscarPais(nombre1);
        Pais p2 = buscarPais(nombre2);
        if (p1 == null) { System.out.println("  No se encontró: " + nombre1); return; }
        if (p2 == null) { System.out.println("  No se encontró: " + nombre2); return; }
        System.out.println("\n  Comparación:");
        System.out.println("  " + "─".repeat(50));
        System.out.printf("  %-20s → %,10.0f km²%n", p1.getNombre(), p1.getSuperficie());
        System.out.printf("  %-20s → %,10.0f km²%n", p2.getNombre(), p2.getSuperficie());
        System.out.println("  " + "─".repeat(50));
        if (p1.getSuperficie() > p2.getSuperficie())
            System.out.printf(" %s tiene mayor superficie.%n", p1.getNombre());
        else if (p2.getSuperficie() > p1.getSuperficie())
            System.out.printf(" %s tiene mayor superficie.%n", p2.getNombre());
        else
            System.out.println("  Ambos tienen la misma superficie.");
    }
