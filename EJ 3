//Clase Continente

import java.util.ArrayList;
import java.util.List;

public class Continente {
    private String nombre;
    private List<Pais> paises;

    public Continente(String nombre) {
        this.nombre = nombre;
        this.paises = new ArrayList<>();
    }

    public void agregarPais(Pais pais) {
        paises.add(pais);
        pais.setContinente(this); // vincula la referencia inversa automáticamente
    }

    public String getNombre()     { return nombre; }
    public List<Pais> getPaises() { return paises; }

    @Override
    public String toString() {
        return "Continente: " + nombre + " (" + paises.size() + " países)";
    }
}

//Clase Provincia

public class Provincia {
    private String nombre;

    public Provincia(String nombre) {
        this.nombre = nombre;
    }

    public String getNombre() {
        return nombre;
    }

    @Override
    public String toString() {
        return "  Provincia: " + nombre;
    }
}

//Clase País

import java.util.ArrayList;
import java.util.List;

public class Pais {
    private String nombre;
    private String capital;
    private double superficie;
    private Continente continente;
    private List<Provincia> provincias;
    private List<Pais> limitrofes;

    public Pais(String nombre, String capital, double superficie) {
        this.nombre = nombre;
        this.capital = capital;
        this.superficie = superficie;
        this.provincias = new ArrayList<>();
        this.limitrofes = new ArrayList<>();
    }

    public void agregarProvincia(Provincia p) {
        provincias.add(p);
    }

    public void agregarLimitrofe(Pais p) {
        if (!limitrofes.contains(p) && !p.equals(this)) {
            limitrofes.add(p);
        }
    }

    public String getNombre()              { return nombre; }
    public String getCapital()             { return capital; }
    public double getSuperficie()          { return superficie; }
    public Continente getContinente()      { return continente; }
    public List<Provincia> getProvincias() { return provincias; }
    public List<Pais> getLimitrofes()      { return limitrofes; }

    public void setContinente(Continente continente) {
        this.continente = continente;
    }

    @Override
    public String toString() {
        String nomContinente = (continente != null) ? continente.getNombre() : "Sin continente";
        return String.format("  Pais: %-20s | Capital: %-18s | Superficie: %,10.0f km² | Continente: %s",
                nombre, capital, superficie, nomContinente);
    }
}

